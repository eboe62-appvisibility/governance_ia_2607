# ==========================================
# INFRASTRUCTURE GOVERNANCE — OPENCODE PROXY SIDECAR
# ==========================================
FROM python:3.14-slim

# Instalar dependencias esenciales de sistema de forma segura
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar uv directamente desde la imagen oficial
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Configurar el usuario seguro sin privilegios (eboe62) con UID/GID 1000
RUN groupadd -g 1000 eboe62 && \
    useradd -u 1000 -g eboe62 -m -s /bin/bash eboe62

WORKDIR /app
RUN chown -R eboe62:eboe62 /app

# Cambiamos al usuario ANTES de clonar y sincronizar con uv.
# Esto garantiza que los symlinks creados por uv pertenezcan legítimamente a eboe62
# y elimina el error "Permission denied (os error 13)".
USER eboe62

# Clonar fijando la rama principal estable de forma limpia
RUN git clone --depth 1 https://github.com/Alishahryar1/free-claude-code.git .

# --------------------------------------------------------------------------
# OPTIMIZACIÓN DE INTERCEPTACIÓN GLOBAL: CORTOCIRCUITO NVIDIA NIM
# Inyecta quirúrgicamente el redireccionamiento buscando el archivo de forma
# recursiva para evitar fallos por cambios de estructura en el upstream.
# --------------------------------------------------------------------------
RUN cat << 'EOF' > patch_router.py
import os
import glob

# Localizar recursivamente el archivo model_router.py en todo el directorio /app
matches = glob.glob("**/model_router.py", recursive=True)

if not matches:
    print("❌ Error Fatal: No se pudo encontrar 'model_router.py' en ninguna parte del repositorio.")
    exit(1)

path = matches[0]
print(f"📁 Archivo encontrado para parchear en: {path}")

with open(path, "r") as f:
    code = f.read()

target = "def resolve(self, claude_model_name: str) -> ResolvedModel:"

# Modificamos el retorno para usar NVIDIA NIM de forma nativa con Thinking habilitado
injection = """def resolve(self, claude_model_name: str) -> ResolvedModel:
        if hasattr(self, "thinking"):
            self.thinking = None

        return ResolvedModel(
            original_model="claude-3-7-sonnet-20250219",
            provider_id="gemini",
            provider_model="gemini-2.5-flash",
            provider_model_ref="gemini/gemini-2.5-flash",
            thinking_enabled=True
        )"""

if target in code:
    code = code.replace(target, injection)
    with open(path, "w") as f:
        f.write(code)
    print("💚 Parche e inyección para Gemini aplicados con éxito")
else:
    print("❌ Error Critico: No se encontró la firma de la función objetivo dentro del archivo")
    exit(1)
EOF
RUN python3 patch_router.py && rm patch_router.py

# Sincronizar dependencias con uv
RUN uv sync

# Exponer el puerto del backend del proxy corporativo
EXPOSE 8082

# Ejecutar usando la herramienta de entorno virtual de uv según el estándar del proyecto
CMD ["uv", "run", "fcc-server", "--host", "0.0.0.0", "--port", "8082"]
